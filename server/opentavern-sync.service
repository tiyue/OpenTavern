# 新手导读：这是 Linux systemd 用来长期运行 Python 云同步服务的配置。
#
# [Unit] 说明它应在网络准备后启动；[Service] 指定运行用户、监听地址、数据库位置和
# Python 入口，并在进程意外退出时自动重启；[Install] 允许服务随系统开机启动。
# 服务只监听 127.0.0.1:8787，公网请求应由 Nginx 转发，避免直接暴露后端端口。
#
# User、Group、脚本路径和数据库目录必须与服务器实际部署一致。修改后需要执行
# systemctl daemon-reload，再重启服务并查看日志；安全限制不要在没有理由时关闭。
[Unit]
Description=OpenTavern Cloud Sync Backend
After=network.target

[Service]
Type=simple
User=opentavern
Group=opentavern
Environment=OPENTAVERN_SYNC_HOST=127.0.0.1
Environment=OPENTAVERN_SYNC_PORT=8787
Environment=OPENTAVERN_SYNC_DB=/var/lib/opentavern-sync/sync.sqlite3
ExecStart=/usr/bin/python3 /opt/opentavern-sync/opentavern_sync_server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
